{
  "name": "wind-solar-site-estimator",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Browser-only wind + solar + battery site viability estimator",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.ts --watch",
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests && tsc -p scripts",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt src tests scripts",
    "fmt:check": "oxfmt --check src tests scripts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm test"
  },
  "devDependencies": {
    "@types/leaflet": "1.9",
    "@types/node": "^26.6.6",
    "chart.js": "^4.4.6",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
