{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": [
    "dist",
    "node_modules"
  ],
  "rules": {
    "import/no-cycle": "error",
    "oxc/no-map-spread": "off",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": [
              "test",
              "describe",
              "it",
              "suite"
            ]
          }
        ]
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/return-await": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/restrict-template-expressions": [
      "error",
      {
        "allowNumber": true
      }
    ],
    "typescript/restrict-plus-operands": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/unbound-method": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error"
  },
  "overrides": [
    {
      "files": [
        "src/model/**",
        "src/wind/**",
        "src/data/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/app/*",
                  "**/ui/*",
                  "**/report/*"
                ],
                "message": "Library code (model, wind, data) must not depend on the UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/report/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/ui/*",
                  "**/app/analyse*",
                  "**/app/init*"
                ],
                "message": "The report renders an Analysis; it must not depend on the UI controls or the run."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/ui/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/app/analyse*",
                  "**/app/init*"
                ],
                "message": "UI controls report changes through callbacks wired in app/init.ts, not by importing the run."
              }
            ]
          }
        ]
      }
    }
  ]
}
