{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "ignorePatterns": [
    "dist",
    "node_modules"
  ],
  "rules": {
    "import/no-cycle": "error",
    "oxc/no-map-spread": "off",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": [
              "test",
              "describe",
              "it",
              "suite"
            ]
          }
        ]
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/return-await": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/restrict-template-expressions": [
      "error",
      {
        "allowNumber": true
      }
    ],
    "typescript/restrict-plus-operands": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/unbound-method": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/explicit-function-return-type": [
      "error",
      {
        "allowExpressions": true,
        "allowTypedFunctionExpressions": true,
        "allowHigherOrderFunctions": true
      }
    ],
    "typescript/consistent-type-definitions": [
      "error",
      "interface"
    ],
    "typescript/array-type": [
      "error",
      {
        "default": "array-simple"
      }
    ],
    "typescript/no-inferrable-types": "error",
    "typescript/prefer-readonly": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-confusing-void-expression": [
      "error",
      {
        "ignoreArrowShorthand": true
      }
    ],
    "typescript/no-meaningless-void-operator": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-deprecated": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/promise-function-async": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "typescript/prefer-return-this-type": "error",
    "typescript/no-unnecessary-qualifier": "error",
    "typescript/related-getter-setter-pairs": "error",
    "eslint/no-inline-comments": "off",
    "eslint/sort-vars": "off",
    "eslint/require-await": "off",
    "eslint/no-negated-condition": "off",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/max-lines-per-function": [
      "error",
      {
        "max": 90,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "eslint/max-lines": [
      "error",
      {
        "max": 260,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "import/max-dependencies": [
      "error",
      {
        "max": 15,
        "ignoreTypeImports": true
      }
    ],
    "eslint/complexity": [
      "error",
      {
        "max": 20
      }
    ],
    "eslint/max-params": [
      "error",
      {
        "max": 5
      }
    ],
    "eslint/max-depth": [
      "error",
      {
        "max": 4
      }
    ],
    "eslint/no-param-reassign": "error",
    "eslint/prefer-template": "error",
    "eslint/no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "unicorn/no-nested-ternary": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/prefer-modern-math-apis": "error",
    "unicorn/numeric-separators-style": "error",
    "unicorn/no-zero-fractions": "error",
    "unicorn/prefer-global-this": "error",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowString": false,
        "allowNumber": false,
        "allowNullableObject": true,
        "allowNullableBoolean": false,
        "allowNullableString": false,
        "allowNullableNumber": false,
        "allowAny": false
      }
    ],
    "typescript/strict-void-return": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": false,
        "requireDefaultForNonUnion": true
      }
    ],
    "typescript/no-unnecessary-condition": "error"
  },
  "overrides": [
    {
      "files": [
        "src/model/**",
        "src/wind/**",
        "src/data/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/app/*",
                  "**/ui/*",
                  "**/report/*"
                ],
                "message": "Library code (model, wind, data) must not depend on the UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/report/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/ui/*",
                  "**/app/analyse*",
                  "**/app/init*"
                ],
                "message": "The report renders an Analysis; it must not depend on the UI controls or the run."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/ui/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/app/analyse*",
                  "**/app/init*"
                ],
                "message": "UI controls report changes through callbacks wired in app/init.ts, not by importing the run."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "scripts/**"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    }
  ]
}
